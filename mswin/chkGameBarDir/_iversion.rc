#include "iversion.h"

1 VERSIONINFO
FileVersion    chkGameBarDir_VMAJOR, chkGameBarDir_VMINOR, chkGameBarDir_VPATCH, chkGameBarDir_VTAIL
ProductVersion chkGameBarDir_VMAJOR, chkGameBarDir_VMINOR, chkGameBarDir_VPATCH, chkGameBarDir_VTAIL
{
    BLOCK "StringFileInfo"
    {
        BLOCK "040904E4"
        //language ID = U.S. English, char set = Windows, Multilingual
        {
            VALUE "CompanyName", "Public Domain"
            VALUE "ProductName",     chkGameBarDir_NAME
            VALUE "FileDescription", chkGameBarDir_NAME
            VALUE "FileVersion",    chkGameBarDir_VMAJORs "." chkGameBarDir_VMINORs "." chkGameBarDir_VPATCHs
            VALUE "ProductVersion",    chkGameBarDir_VMAJORs "." chkGameBarDir_VMINORs "." chkGameBarDir_VPATCHs
            VALUE "LegalCopyright",    "Public domain"
            VALUE "OriginalFilename" , chkGameBarDir_NAME ".exe"
            VALUE "InternalName", chkGameBarDir_NAME ".exe"
            VALUE "Comments","Presented by public domain"
        }
    }

    BLOCK "VarFileInfo"
    {
        VALUE "Translation", 0x0409, 1252
    }
}
